# =====================================================
# AKAIUNSAN Monorepo — Root Environment Variables
# =====================================================
# Copy to .env (gitignored) and fill in actual values.
# Never commit .env file.

# ---- Database ----
POSTGRES_USER="ak_user"
POSTGRES_PASSWORD="CHANGE_ME"
POSTGRES_DB="ak_main"
DATABASE_URL="postgresql://ak_user:CHANGE_ME@localhost:5432/ak_main?schema=public"

# ---- Redis ----
REDIS_URL="redis://localhost:6379"

# ---- MinIO ----
MINIO_ROOT_USER="ak_admin"
MINIO_ROOT_PASSWORD="CHANGE_ME_MIN_PASSWORD"
MINIO_ENDPOINT="localhost:9000"
# Production: HTTPS hostname routed by Caddy/Cloudflare to MinIO.
MINIO_PUBLIC_ENDPOINT="https://storage.ak-tunnel.example.com"

# ---- Auth ----
# 256-bit random string. Generate: openssl rand -hex 32
JWT_SECRET="CHANGE_ME_RANDOM_32_BYTES"
JWT_ACCESS_TTL_SECONDS=900
TOTP_ENCRYPTION_KEY="base64-encoded-32-byte-key"
TOTP_ENCRYPTION_KEY_VERSION=1
# Local/test only. Optional exact 4-digit second-step code; forbidden in production.
DEV_FIXED_ADMIN_2FA_CODE=
JWT_REFRESH_TTL_SECONDS=2592000

# ---- Internal API (service-to-service between attendance + payroll) ----
# Generate: openssl rand -hex 32
INTERNAL_API_KEY="CHANGE_ME_RANDOM_32_BYTES"

# ---- SMS Gateway ----
# Production requires speedsms; mock is limited to local development and tests.
SMS_MODE="mock"
# SpeedSMS provider (required when SMS_MODE=speedsms)
SPEEDSMS_ACCESS_TOKEN=""
SPEEDSMS_SENDER="AKAIUNSAN"
SPEEDSMS_SMS_TYPE=4

# ---- Server ----
NODE_ENV="development"
ATTENDANCE_API_PORT=3000
PAYROLL_API_PORT=3001

# ---- Caddy / Cloudflare Tunnel ----
# CADDY_DOMAIN="ak-tunnel.example.com"
# TUNNEL_TOKEN=""

# ---- Logging ----
LOG_LEVEL="info"

# ---- Encrypted off-host backups (production operator config) ----
# Example SFTP target: sftp:backup@backup.example:/srv/restic/akaiunsan
# Example rotated encrypted USB target: /mnt/ak-offsite/restic
RESTIC_REPOSITORY=""
# Generate independently with: openssl rand -hex 32
# Preserve this value in the approved off-host secret vault; never commit it.
RESTIC_PASSWORD=""
