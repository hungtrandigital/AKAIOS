{
  "name": "ak-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "AKAIUNSAN attendance + payroll monorepo (PRD-EPIC-002)",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "next>postcss": "8.5.23",
      "next>sharp": "0.35.0",
      "exceljs>uuid": "11.1.1"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "pnpm test:unit",
    "test:unit": "turbo run test:unit --filter=@ak/shared --filter=@ak/attendance-api --filter=@ak/payroll-api",
    "test:integration": "turbo run test:integration --filter=@ak/attendance-api --filter=@ak/payroll-api",
    "test:coverage": "turbo run test:coverage --filter=@ak/attendance-api --filter=@ak/payroll-api",
    "test:e2e": "turbo run test:e2e --filter=@ak/payroll-web-admin",
    "clean": "turbo run clean && rm -rf node_modules",
    "prisma:migrate": "pnpm --filter @ak/shared run prisma:migrate",
    "prisma:migrate:deploy": "pnpm --filter @ak/shared run prisma:migrate:deploy",
    "prisma:generate": "pnpm --filter @ak/shared run prisma:generate",
    "prisma:studio": "pnpm --filter @ak/shared run prisma:studio",
    "docker:up": "docker compose --env-file .env -f systems/shared/docker-compose.yml up -d --build",
    "docker:up:dev": "docker compose -f systems/shared/docker-compose.dev.yml up -d",
    "docker:down": "docker compose --env-file .env -f systems/shared/docker-compose.yml down",
    "docker:down:dev": "docker compose -f systems/shared/docker-compose.dev.yml down",
    "docker:logs": "docker compose --env-file .env -f systems/shared/docker-compose.yml logs -f"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "es2022": true,
      "node": true
    },
    "parser": "@typescript-eslint/parser",
    "plugins": ["@typescript-eslint"],
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended"
    ],
    "ignorePatterns": [
      "**/dist/**",
      "**/.next/**",
      "**/coverage/**",
      "**/node_modules/**"
    ],
    "rules": {
      "@typescript-eslint/no-explicit-any": "warn",
      "@typescript-eslint/no-unused-vars": [
        "error",
        {
          "argsIgnorePattern": "^_",
          "varsIgnorePattern": "^_"
        }
      ]
    }
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@types/node": "^20.14.0",
    "eslint": "^8.57.0",
    "turbo": "^2.1.0",
    "typescript": "^5.5.0"
  }
}
