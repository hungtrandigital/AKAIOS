# Attendance API env — copy to .env
NODE_ENV=development
ATTENDANCE_API_PORT=3000
LOG_LEVEL=info

# Inherited from root .env
DATABASE_URL=postgresql://ak_user:CHANGE_ME@localhost:5432/ak_main
REDIS_URL=redis://localhost:6379
MINIO_ROOT_USER=ak_admin
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_ENDPOINT=localhost:9000

JWT_SECRET=CHANGE_ME_RANDOM_32_BYTES
JWT_ACCESS_TTL_SECONDS=900
TOTP_ENCRYPTION_KEY=BASE64_ENCODED_32_BYTE_KEY
TOTP_ENCRYPTION_KEY_VERSION=1

INTERNAL_API_KEY=CHANGE_ME_RANDOM_32_BYTES
TRUSTED_PROXY=127.0.0.1,::1

SMS_MODE=mock
# Required for production SMS_MODE=speedsms
SPEEDSMS_ACCESS_TOKEN=
SPEEDSMS_SENDER=AKAIUNSAN
SPEEDSMS_SMS_TYPE=4
