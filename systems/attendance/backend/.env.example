# Attendance API env — copy to .env
NODE_ENV=development
ATTENDANCE_API_PORT=3000
LOG_LEVEL=info

# Inherited from root .env
DATABASE_URL=postgresql://ak_user:CHANGE_ME@localhost:5432/ak_main
REDIS_URL=redis://localhost:6379
MINIO_ROOT_USER=ak_admin
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_ENDPOINT=localhost:9000

JWT_SECRET=CHANGE_ME_RANDOM_32_BYTES
JWT_ACCESS_TTL_SECONDS=900

INTERNAL_API_KEY=CHANGE_ME_RANDOM_32_BYTES

SMS_MODE=mock
