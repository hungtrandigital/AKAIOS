<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash. The padded square keeps the Prismate
         wordmark inside the platform icon mask's safe area. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/prismate_splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/white</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
