# Caddy origin config for AKAIUNSAN. Cloudflare Tunnel terminates public TLS and
# reaches this proxy on HTTP :80; the internal Attendance endpoint is never
# exposed here. The storage hostname is explicit so stopping Caddy closes both
# application and object-storage ingress during a deployment maintenance window.

http://{$CADDY_STORAGE_HOST:storage.localhost} {
	encode zstd gzip
	reverse_proxy minio:9000
}

# Application origin (HTTP only; Cloudflare owns public TLS).
:80 {
	# Controlled UAT download. Local/Windows compose profiles mount the ignored
	# Flutter build output at /srv/apk; production returns 404 when it is absent.
	handle /downloads/akaios-attendance-debug.apk {
		root * /srv/apk
		rewrite * /app-debug.apk
		header {
			Cache-Control "no-store"
			Content-Disposition "attachment; filename=akaios-attendance-debug.apk"
			Content-Type "application/vnd.android.package-archive"
			X-Content-Type-Options "nosniff"
		}
		file_server
	}

	# Mobile clients use /api/attendance/v1/* as a stable public prefix. Strip
	# only /api/attendance so Fastify receives its canonical /v1/* route.
	# Web-admin aliases such as /api/attendance/auth/* intentionally fall
	# through to Next.js, whose rewrites map them to the correct backend route.
	handle /api/attendance/v1/* {
		uri strip_prefix /api/attendance
		reverse_proxy attendance-api:3000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
	# Web admin and its /api aliases (including payroll) are rewritten by Next.js.
	handle {
		reverse_proxy web-admin:3002 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
}
