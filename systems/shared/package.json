{
  "name": "@ak/shared",
  "version": "1.0.0",
  "description": "Shared types, Prisma client, auth utilities for AKAIUNSAN attendance + payroll systems",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./db": {
      "types": "./dist/db/client.d.ts",
      "default": "./dist/db/client.js"
    },
    "./auth/*": {
      "types": "./dist/auth/*.d.ts",
      "default": "./dist/auth/*.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo coverage",
    "prisma:generate": "prisma generate --schema=src/db/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=src/db/prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=src/db/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=src/db/prisma/schema.prisma",
    "db:seed": "tsx src/db/seeds/dev-seed.ts",
    "db:seed:demo": "tsx src/db/seeds/demo-accounts.ts",
    "db:seed:attendance": "tsx src/db/seeds/attendance-demo.ts",
    "db:seed:rbac": "tsx src/db/seeds/rbac.ts",
    "db:seed:all": "pnpm db:seed && pnpm db:seed:demo && pnpm db:seed:attendance && pnpm db:seed:rbac",
    "db:reset": "prisma migrate reset --schema=src/db/prisma/schema.prisma --skip-seed && pnpm db:seed:all",
    "auth:provision-operator": "tsx src/auth/provision-operator.ts",
    "auth:enroll-totp": "tsx src/auth/enroll-totp.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.668.0",
    "@aws-sdk/s3-request-presigner": "^3.668.0",
    "@prisma/client": "^5.20.0",
    "argon2": "^0.41.1",
    "decimal.js": "^10.4.3",
    "jsonwebtoken": "^9.0.2",
    "redis": "^4.7.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "eslint": "^8.57.0",
    "prisma": "^5.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
