{
  "name": "@ak/payroll-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --reporter=verbose",
    "test:watch": "vitest",
    "test:coverage": "vitest run tests/unit --coverage --coverage.include='src/engine/**/*.ts' --coverage.thresholds.lines=90 --coverage.thresholds.functions=90 --coverage.thresholds.statements=90 --coverage.thresholds.branches=90",
    "test:e2e": "echo 'E2E tests in Phase 3'",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@ak/shared": "workspace:*",
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^10.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "^5.20.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.8.3",
    "fastify-plugin": "^5.1.0",
    "pino-pretty": "^11.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^8.57.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
